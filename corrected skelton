  <!-- Cesium Script -->
  <script>
    var viewer = new Cesium.Viewer('cesiumContainer', {
      imageryProvider: new Cesium.IonImageryProvider({ assetId: 3 }),
      baseLayerPicker: true
    });
    Cesium.GeoJsonDataSource.load(
      'https://raw.githubusercontent.com/johan/world.geo.json/master/countries.geo.json'
    ).then(function(ds) {
      viewer.dataSources.add(ds);
      ds.entities.values.forEach(function(entity) {
        if (entity.polygon) {
          entity.polygon.material = Cesium.Color.YELLOW.withAlpha(0.2);
          entity.polygon.outline = true;
          entity.polygon.outlineColor = Cesium.Color.BLACK;
        }
      });
    });
    function searchLocation() {
      var query = document.getElementById('searchBox').value;
      if (!query) return;
      var geocoder = new Cesium.GeocoderService();
      geocoder.geocode(query).then(function(results) {
        if (results.length > 0) {
          viewer.camera.flyTo({ destination: results[0].destination });
        } else { alert("Location not found."); }
      });
    }
  </script>

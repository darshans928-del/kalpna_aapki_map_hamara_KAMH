<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Kalpana2Map – Dream to Map</title>
  <script src="https://cesium.com/downloads/cesiumjs/releases/1.114/Build/Cesium/Cesium.js"></script>
  <link href="https://cesium.com/downloads/cesiumjs/releases/1.114/Build/Cesium/Widgets/widgets.css" rel="stylesheet">
  <style>
    html, body {
      scroll-behavior: smooth; /* enables smooth scrolling */
      margin: 0; padding: 0;
      font-family: sans-serif;
    }
    #cesiumContainer {
      width: 100%; height: 600px; margin: 0; padding: 0; overflow: hidden;
    }
    nav {
      background:#333; padding:10px; text-align:center;
    }
    nav a {
      color:white; margin:0 15px; text-decoration:none; font-weight:bold;
    }
    section {
      padding:50px; text-align:center;
    }
    section:nth-child(even) {
      background:#f4f4f4;
    }
  </style>
</head>
<body>
  <!-- Logo Banner -->
  <div style="background:#004d99; color:white; padding:20px; text-align:center;">
    <h1 style="margin:0; font-size:2.5em;">🌍 Kalpana2Map</h1>
    <h2 style="margin:0; font-size:1.5em;">कल्पना से नक्शा</h2>
    <p style="margin-top:10px;">Turning imagination into maps – आपकी कल्पना, हमारा नक्शा</p>
  </div>

  <!-- Navigation Bar -->
  <nav>
    <a href="#home">Home</a>
    <a href="#gallery">Gallery</a>
    <a href="#upload">Upload</a>
    <a href="#commitment">Commitment</a>
    <a href="#contact">Contact</a>
  </nav>

  <!-- Globe Section -->
  <section id="home">
    <div id="cesiumContainer"></div>
  </section>

  <!-- Gallery Section -->
  <section id="gallery">
    <h2>Gallery</h2>
    <p>Explore maps created by the community.</p>
  </section>

  <!-- Upload Section -->
  <section id="upload">
    <h2>Upload</h2>
    <p>Share your ideas or files to turn imagination into maps.</p>
  </section>

  <!-- Commitment Section -->
  <section id="commitment">
    <h2>Our Commitment</h2>
    <p>We invite you to share your imagination. We will turn it into maps.</p>
    <p>हम आपको आमंत्रित करते हैं कि आप अपनी कल्पना साझा करें। हम उसे नक्शे में बदलेंगे।</p>
  </section>

  <!-- Contact Section -->
  <section id="contact">
    <h2>Contact Us</h2>
    <p>Email: info@kalpana2map.org</p>
  </section>

  <!-- Cesium Globe Script -->
  <script>
    var viewer = new Cesium.Viewer('cesiumContainer', {
      imageryProvider: new Cesium.IonImageryProvider({ assetId: 3 }), // Bing Maps with labels
      baseLayerPicker: true
    });

    Cesium.GeoJsonDataSource.load(
      'https://raw.githubusercontent.com/johan/world.geo.json/master/countries.geo.json'
    ).then(function(dataSource) {
      viewer.dataSources.add(dataSource);
      var entities = dataSource.entities.values;
      for (var i = 0; i < entities.length; i++) {
        var entity = entities[i];
        if (entity.polygon) {
          entity.polygon.material = Cesium.Color.YELLOW.withAlpha(0.2);
          entity.polygon.outline = true;
          entity.polygon.outlineColor = Cesium.Color.BLACK;
        }
      }
    });
  </script>
</body>
</html>
